# ─────────────────────────────────────────────────────────────────────────────
# NEVER commit a real .env file. On Railway, set these in the service's
# "Variables" tab instead. This file only documents the names.
# ─────────────────────────────────────────────────────────────────────────────

# ── Remote server (Railway / Claude custom connector) ────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# (application type: "Web application").
YOUTUBE_CLIENT_ID=your_client_id_here
YOUTUBE_CLIENT_SECRET=your_client_secret_here

# Random secret, at least 32 characters. Encrypts every token the server hands out.
# Open https://<your-railway-domain>/ before it is set and the page shows a fresh one.
# Changing it signs everyone out (you must reconnect the connector in Claude).
TOKEN_ENCRYPTION_KEY=

# Email of the Google account that owns the YouTube channel (comma-separated for more).
# Nobody else can sign in.
ALLOWED_GOOGLE_EMAILS=you@example.com

# Public https address of the server. Railway sets RAILWAY_PUBLIC_DOMAIN automatically
# once you generate a domain, so this is only needed for a custom domain.
# PUBLIC_URL=https://my-app.up.railway.app

# Optional hardening / tuning
# YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxx   # refuse to connect any other channel
# DISPLAY_TIMEZONE=Europe/Kyiv                    # time zone shown on the approval page
# UI_LANGUAGE=uk                                  # uk | en (approval/status pages)
# MAX_UPLOAD_MB=2048                              # biggest video the server will relay
# ALLOWED_DOWNLOAD_HOSTS=drive.google.com,dropbox.com   # restrict download links (empty = any public https host)
# ALLOWED_ORIGINS=                                # extra browser origins allowed to call /mcp
# ALLOWED_REDIRECT_URIS=                          # extra OAuth redirect URIs for Claude (normally not needed)
# YOUTUBE_MCP_ALLOW_DESTRUCTIVE=false             # true = also expose playlist/comment/section deletion (never video deletion)

# ── Local (stdio) mode ───────────────────────────────────────────────────────
# YOUTUBE_MCP_TRANSPORT=stdio   # stdio (default) or http
# YOUTUBE_MCP_HTTP_PORT=3000    # http only (Railway's PORT is used automatically)
# YOUTUBE_MCP_HTTP_HOST=127.0.0.1

# ── Common ───────────────────────────────────────────────────────────────────
# Quota: warn threshold (default 9000 of 10000 daily units)
YOUTUBE_MCP_QUOTA_LIMIT=9000
# Log level: error | warn | info | debug
YOUTUBE_MCP_LOG_LEVEL=info
NODE_ENV=production
